# triage — copy to ~/.config/triage/.env (or point TRIAGE_ENV at it), mode 0600.
#
# Everything is optional: a source registers when it has what it needs, and
# says at boot which mode it came up in. Each variable is documented with its
# default in docs/ (docs/configuration.md says where).
#
# Format: bare KEY=value. No quotes needed, no spaces around "=", "~" is not
# expanded, and "#" only at the start of a line — a comment after a value
# becomes part of the value. Uncomment a line to use it.

# ---- GitHub (on when a token resolves) — docs/sources/github.md -------------
# A *classic* token with the `notifications` scope: the inbox endpoints do not
# accept fine-grained tokens. Unset, `gh auth token` is tried.
#GITHUB_TOKEN=ghp_…
# Unset: GET /user at boot.
#GITHUB_USER=alice
# on | off | fake. Unset: on if a token resolves.
#TRIAGE_GITHUB=on
# GitHub Enterprise. Unset: api.github.com.
#TRIAGE_GITHUB_URL=https://github.example.com/api/v3
# Read threads already marked read, too. Expensive on a large inbox.
#TRIAGE_GITHUB_ALL=1
# Open issues as state. TRIAGE_ISSUES is read as an alias.
#TRIAGE_GITHUB_ISSUES=acme/widgets, acme/site
# How often each open set is read, for both forges.
#TRIAGE_ISSUES_EVERY_MIN=5
# One entry per owner the default token cannot read: a token file, or a gh config dir.
#TRIAGE_TOKENS_DIR=/home/alice/.config/triage/tokens

# ---- GitLab (on when a token resolves) — docs/sources/gitlab.md -------------
# A personal access token with `read_api`, plus `api` if Done is to mark the
# todo done. Unset, `glab auth token` is tried.
#GITLAB_TOKEN=glpat-…
#GITLAB_USER=alice
#TRIAGE_GITLAB=on
# The instance; the API is /api/v4 under it.
#TRIAGE_GITLAB_URL=https://gitlab.com
# Open issues as state; a path may nest.
#TRIAGE_GITLAB_ISSUES=acme/platform

# ---- Calendar (read-only) — docs/sources/calendar.md ------------------------
# The feed URL is the credential: Google's "secret address in iCal format",
# Outlook's published ICS link, any subscription URL. Only its host is logged.
#TRIAGE_CALENDAR_URL=https://calendar.google.com/calendar/ical/…/private-…/basic.ics
# Or a file on disk; not both.
#TRIAGE_CALENDAR_FILE=/home/alice/calendar.ics
# Your address on invitations; without it no invitation is yours to answer.
#TRIAGE_CALENDAR_ME=alice@example.com
# off | ics | google | fake. Unset: ics when a feed is named, google when its credentials resolve.
#TRIAGE_CALENDAR=ics
# The project. Unset: the feed's own name (Google path: primary).
#TRIAGE_CALENDAR_ID=work
#TRIAGE_CALENDAR_EVERY_MIN=5
#TRIAGE_CALENDAR_WINDOW_H=48
#TRIAGE_CALENDAR_SOON_MIN=15
# The other path, Google's API: off until bin/google-consent.js has minted a
# refresh token (google-oauth.json + google-token.json beside this file, or
# the files named below), or the three values are given.
#GOOGLE_CLIENT_FILE=/home/alice/.config/triage/google-oauth.json
#GOOGLE_TOKEN_FILE=/home/alice/.config/triage/google-token.json
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GOOGLE_REFRESH_TOKEN=

# ---- Ledger — docs/sources/ledger.md -----------------------------------------
# A markdown queue file agents write to; its `status/` sibling is the handoffs directory.
#TRIAGE_LEDGER=/home/alice/.local/state/ledger/OPEN_LOOPS.md

# ---- Home Assistant to-do lists — docs/sources/home-assistant.md ------------
# off | on | fake. Unset: on when URL, token and lists are all set.
#TRIAGE_HA=on
#HA_URL=http://homeassistant.local:8123
#HA_TOKEN=
# A list ending in `inbox` is yours; the rest are the house's.
#HA_LISTS=todo.alice_inbox, todo.household
# Default: <HA_URL>/todo
#TRIAGE_HA_DASHBOARD=

# ---- CRM (Twenty, read-only key) — docs/sources/crm.md ----------------------
# off | on | fake. Unset: on when URL, key and ME are all set.
#TRIAGE_CRM=on
#TWENTY_URL=https://crm.example.com
# A key bound to a read-only role; never an admin key.
#TWENTY_API_KEY=
# You, as a workspace member: id, email or full name.
#TRIAGE_CRM_ME=alice@example.com
# The key names your own agents' API edits carry. Unset: you have no agents.
#TRIAGE_CRM_AGENTS=
# Company Name=project, so preferences and statements can scope to a company.
#TRIAGE_CRM_PROJECTS=Acme Corp=acme
# No complete read for this long is a P0; 0 turns the alarm off.
#TRIAGE_CRM_STALE_MIN=30

# ---- Interrupts — docs/interrupts.md -----------------------------------------
# A webhook is the usual way: one URL and nothing else. Slack's incoming
# webhook, Discord's channel webhook, or any endpoint that takes JSON. Point
# it at a channel only you are in. SLACK_WEBHOOK_URL is read as an alias.
#TRIAGE_WEBHOOK_URL=https://hooks.slack.com/services/T…/B…/…
# Who the message names, so it notifies you rather than badging the channel:
# a Slack member id, a Discord id or role, or any text for generic.
#TRIAGE_MENTION=U0123ABCD
# slack | discord | generic | off. Unset: inferred from the URL's host.
#TRIAGE_NOTIFY=slack
# off | webhook | app. Unset: inferred from what is set.
#TRIAGE_SLACK=webhook
# The quiet window; empty disables it.
#TRIAGE_QUIET=23:00-07:00
#TRIAGE_TZ=America/Vancouver
#TRIAGE_COALESCE_MIN=10
# An event older than this is placed in the list, not sent.
#TRIAGE_DELIVER_MAX_AGE_H=24
# The top layer of what may interrupt: [+|-]source:rule[@project], comma-separated; `off` silences all.
#TRIAGE_INTERRUPT=
# App mode (buttons, /triage, the Home tab) needs the app from slack/manifest.yml, and `npm ci`.
#SLACK_BOT_TOKEN=xoxb-…
#SLACK_APP_TOKEN=xapp-…
#SLACK_USER_ID=U0123ABCD

# ---- Ranking and preferences — docs/ranking.md -------------------------------
# Default: preferences.json beside this file (see preferences.example.json).
#TRIAGE_PREFS=
#TRIAGE_RANK_PREFER=repo:acme/*=0.4, source:calendar=0.3
#TRIAGE_RANK_W_CLAIM=1
#TRIAGE_RANK_W_TIME=0.6
#TRIAGE_RANK_W_PREFER=0.4
#TRIAGE_RANK_CORROBORATE=0.25
#TRIAGE_RANK_HYSTERESIS=0.02
# Items the boot-time backfill takes; 0 disables it.
#TRIAGE_RANK_BACKFILL=500
# Declared and permanently absent (there is no model): setting them does nothing.
#TRIAGE_RANK_W_RELEVANCE=0
#TRIAGE_RANK_W_EFFORT=0

# ---- The process — docs/configuration.md -------------------------------------
# Every source on its fake, store in memory, nothing sent off the box (npm run demo).
#TRIAGE_DEMO=1
#TRIAGE_PORT=3300
#TRIAGE_HOST=127.0.0.1
# Write the full path: ~ is not expanded.
#TRIAGE_DB=/home/alice/.local/state/triage/triage.db
# Set by a deployer, never by hand: the commit /healthz reports.
#TRIAGE_COMMIT=
