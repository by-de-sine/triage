# triage — copy to ~/.config/triage/.env (or point TRIAGE_ENV at it), mode 0600.
# Everything is optional; a source registers when it has what it needs, and
# says at boot which of its modes it came up in. README.md §Configuration has
# every variable with its default; this file is the short tour.

# ---- GitHub (on when a token resolves) ---------------------------------------
# A *classic* token with the `notifications` scope: the inbox endpoints do not
# accept fine-grained tokens. Unset, `gh auth token` is tried.
#GITHUB_TOKEN=ghp_…
#GITHUB_USER=alice                       # unset: GET /user at boot
#TRIAGE_GITHUB=on                        # on | off; unset: on if a token resolves
#TRIAGE_GITHUB_URL=https://github.example.com/api/v3   # GitHub Enterprise; unset: api.github.com
#TRIAGE_GITHUB_ISSUES=acme/widgets, acme/site   # open issues as state (plan §12.3 item 2); TRIAGE_ISSUES is read as an alias
#TRIAGE_ISSUES_EVERY_MIN=5               # for both forges
#TRIAGE_TOKENS_DIR=/home/alice/.config/triage/tokens   # one entry per owner, for owners the default token cannot read: a file, or a gh config dir

# ---- GitLab (on when a token resolves; plan §16, G1) -------------------------
# A personal access token with `read_api` — `api` if Done is to mark the todo
# done. Unset, `glab auth token` is tried.
#GITLAB_TOKEN=glpat-…
#GITLAB_USER=alice                       # unset: GET /user at boot
#TRIAGE_GITLAB=on                        # on | off; unset: on if a token resolves
#TRIAGE_GITLAB_URL=https://gitlab.com    # the instance; the API is /api/v4 under it
#TRIAGE_GITLAB_ISSUES=acme/platform      # open issues as state; a path may nest

# ---- Calendar (Google, read-only) -------------------------------------------
# Off until bin/google-consent.js has minted a refresh token beside this file
# (google-oauth.json + google-token.json), or the three values are given.
#TRIAGE_CALENDAR=google                  # off | google | fake; unset: google when credentials resolve
#TRIAGE_CALENDAR_ID=primary
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GOOGLE_REFRESH_TOKEN=

# ---- Ledger (a markdown queue file written by agents, plan §12.3 item 1) ----
# Off unless this names the file; its `status/` sibling is the handoffs directory.
#TRIAGE_LEDGER=/home/alice/.local/state/ledger/OPEN_LOOPS.md

# ---- Home Assistant to-do lists (plan §12.8) -----------------------------------
#TRIAGE_HA=on                            # off | on | fake; unset: on when URL, token and lists are all set
#HA_URL=http://homeassistant.local:8123
#HA_TOKEN=
#HA_LISTS=todo.alice_inbox, todo.household   # a list ending in `inbox` is yours; the rest is the house's
#TRIAGE_HA_DASHBOARD=                    # default <HA_URL>/todo

# ---- CRM (Twenty, read-only key; plan §12.3 item 3) -------------------------
#TRIAGE_CRM=on                           # off | on | fake; unset: on when URL, key and ME are all set
#TWENTY_URL=https://crm.example.com
#TWENTY_API_KEY=                         # a key bound to a read-only role; never an admin key
#TRIAGE_CRM_ME=alice@example.com         # you, as a workspace member: id, email or full name
#TRIAGE_CRM_AGENTS=                      # the key names your own agents' API edits carry; none by default
#TRIAGE_CRM_PROJECTS=Acme Corp=acme      # Company Name=project, so prefs and statements can scope to it
#TRIAGE_CRM_STALE_MIN=30                 # no complete read for this long is a P0; 0 turns it off

# ---- Interrupts (Slack) ------------------------------------------------------
# Webhook mode is the usual one: an incoming webhook URL and nothing else.
#TRIAGE_SLACK=webhook                    # off | webhook | app; unset infers from what is set
#SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T…/B…/…
#TRIAGE_MENTION=U0123ABCD                # so the message notifies you rather than badges the channel
#TRIAGE_QUIET=23:00-07:00                # "" disables
#TRIAGE_TZ=America/Vancouver
#TRIAGE_INTERRUPT=                       # the top layer of what may interrupt (README §Interrupts); `off` silences all
# App mode (buttons, /triage, the Home tab) needs the app from slack/manifest.yml:
#SLACK_BOT_TOKEN=xoxb-…
#SLACK_APP_TOKEN=xapp-…
#SLACK_USER_ID=U0123ABCD

# ---- Ranking and preferences -------------------------------------------------
#TRIAGE_PREFS=                           # default: preferences.json beside this file (see preferences.example.json)
#TRIAGE_RANK_PREFER=repo:acme/*=0.4, source:calendar=0.3

# ---- The process -------------------------------------------------------------
#TRIAGE_PORT=3300
#TRIAGE_HOST=127.0.0.1
#TRIAGE_DB=~/.local/state/triage/triage.db    # note: ~ is not expanded in this file; write the full path
